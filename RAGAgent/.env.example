# Optional LLM configuration. If not set, the app uses grounded fallback responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Backend configuration
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# RAG configuration
CHUNK_SIZE=600
CHUNK_OVERLAP=120
TOP_K=5
RELEVANCE_THRESHOLD=0.35
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Demo settings
DEMO_MODE=true
DEMO_DOCUMENTS_DIR=./backend/data/demo_documents
UPLOAD_DIR=./backend/data/uploads
